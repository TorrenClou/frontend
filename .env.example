# TorrenClou frontend — local development overrides.
#
# Copy to .env.local if you need any of these. Every value below has a working
# default in code, so an empty file is a valid file. The deployed all-in-one
# image sets what it needs itself; nothing here is required to run the product.
#
#   cp .env.example .env.local

# Where the .NET API lives. Read server-side only, and proxied through
# /proxy/api so the browser never talks to it directly — which is why there
# are no NEXT_PUBLIC_* variables in this app.
# Default: http://localhost:47200
#BACKEND_URL=http://localhost:47200

# Signing key for NextAuth sessions. This is the one value with no fallback:
# without it, sign-in fails. Generate one with `openssl rand -base64 32`.
#NEXTAUTH_SECRET=

# Public URL of this app. NextAuth uses it to build callback URLs.
# Default: http://localhost:3000
#NEXTAUTH_URL=http://localhost:3000

# Accept self-signed certificates when calling the API. Development only —
# never set this in production. Already implied when NODE_ENV=development.
# Default: unset (certificates are verified)
#ALLOW_INSECURE_TLS=false
